     return round(float((np.abs(s[:191, :107] - s[:191, 1:108]).mean() + np.abs(s[:191, :107] - s[1:192, :107]).mean()) / 2), 3)
 
 
+def _lock(profile: np.ndarray, p0: float, span: float = 0.03, n: int = 121) -> tuple[float, float]:
+    """The grid period near p0 and the offset in [0, period) of its cell borders: the comb that best lines up with the
+    hard-edge profile (largest Fourier term). The period is refined per axis because the shot's median period is not
+    exact enough to sample cell centres: 0.3% off drifts a whole cell across 180 cells."""
+    pos = np.arange(len(profile)) + 1.0  # profile[i] is the step between pixels i and i + 1
+    ps = p0 * np.linspace(1 - span, 1 + span, n)
+    z = np.exp(-2j * np.pi * pos[None] / ps[:, None]) @ (profile - profile.mean())
+    k = int(np.argmax(np.abs(z)))
+    return float(ps[k]), float(-np.angle(z[k]) / (2 * np.pi) * ps[k]) % float(ps[k])
+
+
+def art_pixels(bgr: np.ndarray, period: float) -> np.ndarray:
+    """One sample per art pixel: the frame read at the cell centres (nearest pixel), phase-aligned to the grid. A
+    resize to art size blends neighbouring cells when the period is not a whole number, and one-pixel patterns vanish."""
+    g = cv2.cvtColor(bgr, cv2.COLOR_BGR2GRAY).astype(np.float32)
+    idx = []
+    for axis, n in ((0, g.shape[0]), (1, g.shape[1])):
+        p, o = _lock((np.abs(np.diff(g, axis=axis)) > 18).mean(1 - axis), period)
+        c = np.floor(o + (np.arange(int(n / p) + 1) + 0.5) * p).astype(int)
+        idx.append(c[c < n])
+    return bgr[np.ix_(*idx)]
+
+
+def dither_share(art: np.ndarray, step: int = 8) -> float:
+    """Share of busy 2x2 windows of art pixels that are checkerboards: each diagonal one tone and one diagonal brighter
+    than the other by more than `step`. Read on brightness, which video coding keeps sharper than colour; a window
+    counts only next to another checkerboard window (dithering comes in runs, a lone match is chance)."""
+    if min(art.shape[:2]) < 3:
+        return 0.0
+    y = cv2.cvtColor(art, cv2.COLOR_BGR2GRAY).astype(np.int16)
+    tl, tr, bl, br = y[:-1, :-1], y[:-1, 1:], y[1:, :-1], y[1:, 1:]
+    gap = np.maximum(np.minimum(tl, br) - np.maximum(tr, bl), np.minimum(tr, bl) - np.maximum(tl, br))
+    checker = (gap > step) & (np.maximum(np.abs(tl - br), np.abs(tr - bl)) * 2 <= gap)
+    run = np.zeros_like(checker)
+    run[:, 1:] |= checker[:, :-1]
+    run[:, :-1] |= checker[:, 1:]
+    run[1:] |= checker[:-1]
+    run[:-1] |= checker[1:]
+    busy = (np.abs(tl - tr) > step) | (np.abs(tl - bl) > step)
+    return float((checker & run).sum() / max(1, busy.sum()))
+
+
